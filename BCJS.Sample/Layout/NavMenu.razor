        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="line"><span class="oi" aria-hidden="true"></span> Line</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="bar"><span class="oi" aria-hidden="true"></span> Bar</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="pie-doughnut"><span class="oi" aria-hidden="true"></span> Pie &amp; Doughnut</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="radar"><span class="oi" aria-hidden="true"></span> Radar</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="mixed"><span class="oi" aria-hidden="true"></span> Mixed</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="zoom"><span class="oi" aria-hidden="true"></span> Zoom</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="datalabels"><span class="oi" aria-hidden="true"></span> Data labels</NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
