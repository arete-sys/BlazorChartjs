@namespace BCJS
@inject IJSRuntime JSRuntime
@inject IServiceProvider Services

<div id="bcjs-container-@Config?.CanvasId"
     class="bcjs-chart-container @Class"
     style="height:@Height; width:@Width; @Style"
     @onmouseout="OnMouseOutAsync">
    <div class="bcjs-chart-canvas">
        <canvas id="@Config?.CanvasId" role="@(AriaLabel is null ? null : "img")" aria-label="@AriaLabel"></canvas>
        @if (ChildContent is not null)
        {
            <div class="bcjs-chart-overlay">@ChildContent</div>
        }
    </div>
</div>
