<Project>

  <!-- Shared baseline for every project in the BCJS solution. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Enforce correctness (compiler + CA analyzers) as build errors, but leave opinionated
         IDExxxx code-style rules to the editor rather than failing the build. -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <!-- Common package identity / metadata (the RCL opts in via IsPackable). -->
  <PropertyGroup>
    <Authors>Arete</Authors>
    <Company>Arete</Company>
    <Product>BCJS</Product>
    <Copyright>Copyright © Arete. Derivative of PSC.Blazor.Components.Chartjs (Enrico Rossini).</Copyright>
    <RepositoryUrl>https://github.com/erossini/BlazorChartjs</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Off by default; only the packable RCL turns these on. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
